{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/devroadmap run dev",
    "dev:server": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/devroadmap run dev",
    "db:init": "pnpm --filter @workspace/scripts run init-db",
    "db:verify": "pnpm --filter @workspace/scripts run verify-db",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:docker": "docker compose up -d",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
