# DevRoadmap Environment Configuration

# Database Connection:
# Set to "local" (or leave blank) to use the built-in persistent PostgreSQL engine (.data/devroadmap.db)
# Or uncomment and set your PostgreSQL connection string (Docker, Laragon, Supabase, Neon, etc.):
DATABASE_URL=local
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devroadmap

# Server & Client Ports:
PORT=5000
BASE_PATH=/

# Authentication (Optional - full platform works in guest mode without Clerk credentials):
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=

